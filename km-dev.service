
[Unit]
Description=KM DEV VPS Deploy Discord Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kmdev
Group=kmdev
WorkingDirectory=/opt/km-dev-vps-bot
EnvironmentFile=/opt/km-dev-vps-bot/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/km-dev-vps-bot/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
